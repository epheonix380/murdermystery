# /etc/systemd/system/murdermystery.service
[Unit]
Description=Murder mystery app (docker compose)
Requires=docker.service
After=docker.service network-online.target postgresql.service
Wants=network-online.target postgresql.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/root/murdermystery
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
ExecReload=/usr/bin/docker compose up -d --build
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
