{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "extras.json: anything unique to one case",
  "type": "object",
  "properties": {
    "map": {
      "type": "object",
      "required": ["rooms"],
      "properties": {
        "rooms": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "x", "y", "w", "h"],
            "properties": {
              "id": {"type": "string"},
              "name": {"type": "string"},
              "x": {"type": "number"}, "y": {"type": "number"},
              "w": {"type": "number"}, "h": {"type": "number"}
            }
          }
        },
        "doors": {"type": "array", "items": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4}}
      }
    }
  }
}
